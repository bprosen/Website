# Upstash Redis REST credentials for the "recent visitors" globe dots
# (src/app/api/visitors). The Vercel Marketplace Upstash integration sets
# these automatically. Either pair works; the UPSTASH_* names win when both
# are present. Without them the API returns an empty list.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Names injected by the Vercel Marketplace Upstash (KV) integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
