{
  "name": "website",
  "version": "1.0.0",
  "description": "Ben Edgar-Prosen's Personal Website",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --linter-enabled=true --formatter-enabled=false src",
    "lint:fix": "biome check --linter-enabled=true --formatter-enabled=true --write src",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "biome:fix": "npm run lint:fix && npm run format:fix",
    "prepare": "husky",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --coverage --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bprosen/Website.git"
  },
  "author": "Ben Edgar-Prosen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bprosen/Website/issues"
  },
  "homepage": "https://github.com/bprosen/Website#readme",
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tabler/icons-react": "^3.50.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "framer-motion": "^14.7.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
